# ==========================================
# Mobatech Flutter App Configuration
# ==========================================
# WARNING: Do not put actual secrets in this file!
# Copy this file to .env and replace placeholders with real values.

# ------------------------------------------
# API Connections
# ------------------------------------------
# Base API URL for backend
# For Android emulator use: http://10.0.2.2:8080/api
# For physical devices use: http://<YOUR_IP>:8080/api
API_BASE_URL=http://127.0.0.1:8080/api

# ------------------------------------------
# WebSocket Connections
# ------------------------------------------
# WebSocket URL for live tracking
# For Android emulator use: ws://10.0.2.2:8080/api
# For physical devices use: ws://<YOUR_IP>:8080/api
WS_BASE_URL=ws://127.0.0.1:8080/api
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
GMAPS_SEARCH_URL=https://www.google.com/maps/search/?api=1&query=
